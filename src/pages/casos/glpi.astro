---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Contato from '../../components/Contato.astro';
import Glpi from '../../components/mockups/Glpi.astro';
import { ArrowLeft } from '@lucide/astro';
import { casoGlpi as c } from '../../data/caso-glpi';
---
<Base titulo={`${c.titulo} · Estudo de caso · Luiz Sanchez`} descricao={c.linha}>
  <Header />
  <main id="conteudo" class="caso">
    <article aria-labelledby="caso-titulo">
      <header class="topo-caso">
        <div class="container-x pt-28 sm:pt-32">
          <a href="/#projeto-glpi" class="voltar"><ArrowLeft class="size-4" aria-hidden="true" /> Projetos</a>
          <p class="tipo">Estudo de caso</p>
          <h1 id="caso-titulo" class="titulo">{c.titulo}</h1>
          <p class="linha">{c.linha}</p>
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Setores">
            {c.setores.map((s) => <li class="pill pill-soft">{s}</li>)}
          </ul>
          <figure class="painel mt-10 lg:mt-14">
            <Glpi />
            <figcaption class="mt-3 text-right text-[0.8rem] text-white">Ilustração da interface</figcaption>
          </figure>
        </div>
      </header>

      <div class="container-x corpo">
        <section aria-labelledby="problema">
          <h2 id="problema">O ponto de partida</h2>
          {c.problema.map((p) => <p class="texto">{p}</p>)}
        </section>

        <section aria-labelledby="feito">
          <h2 id="feito">O que eu fiz</h2>
          <ol class="passos">
            {c.feito.map((f) => (
              <li>
                <h3>{f.titulo}</h3>
                <p>{f.texto}</p>
              </li>
            ))}
          </ol>
        </section>

        <section aria-labelledby="resultado">
          <h2 id="resultado">Resultado</h2>
          {c.numeros.length > 0 && (
            <dl class="numeros">
              {c.numeros.map((n) => (
                <div>
                  <dt>{n.rotulo}</dt>
                  <dd>{n.valor}</dd>
                </div>
              ))}
            </dl>
          )}
          {c.resultado.map((p) => <p class="texto">{p}</p>)}
        </section>
      </div>
    </article>
    <Contato />
  </main>
</Base>

<style>
  .topo-caso { background: var(--color-night-2); padding-bottom: 4rem; }
  .voltar { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; color: var(--color-accent); }
  .voltar:hover { text-decoration: underline; text-underline-offset: 4px; }
  .tipo { margin-top: 1.5rem; color: var(--color-muted); }
  .titulo { margin-top: 0.4rem; font-size: clamp(2.6rem, 1.6rem + 4vw, 5rem); line-height: 1; }
  .linha { margin-top: 1.25rem; max-width: 40ch; font-size: clamp(1.2rem, 1rem + 0.7vw, 1.5rem); line-height: 1.4; color: var(--color-ink-muted); }
  .painel {
    max-width: 56rem;
    padding: 20px 20px 14px;
    border-radius: 28px;
    background: linear-gradient(135deg, #8a4200, #b35f00);
  }
  @media (min-width: 640px) { .painel { padding: 40px 40px 20px; } }

  .corpo { max-width: 52rem; padding-top: 4rem; padding-bottom: 6rem; }
  .corpo section + section { margin-top: 4rem; }
  .corpo h2 { font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.5rem); line-height: 1.1; }
  .texto { margin-top: 1rem; font-size: 1.15rem; line-height: 1.6; color: var(--color-ink-muted); }

  /* Os passos são uma sequência real (do pedido à manutenção): numerados */
  .passos { margin-top: 1.5rem; counter-reset: passo; }
  .passos > li {
    position: relative;
    padding: 1.4rem 0 1.4rem 3.5rem;
    border-top: 1px solid var(--color-line);
    counter-increment: passo;
  }
  .passos > li::before {
    content: counter(passo);
    position: absolute;
    left: 0;
    top: 1.35rem;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 9999px;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(135deg, #8a4200, #d97a12);
  }
  .passos h3 { font-size: 1.25rem; font-weight: 600; color: var(--color-on-dark); }
  .passos p { margin-top: 0.35rem; line-height: 1.55; color: var(--color-ink-muted); }

  .numeros { margin-top: 1.5rem; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .numeros > div { padding: 24px; border-radius: 20px; background: linear-gradient(135deg, #fff1e3, #ffe1c2); }
  .numeros dd { order: -1; font-size: 3rem; font-weight: 600; line-height: 1; letter-spacing: -0.04em; color: #8a4200; }
  .numeros > div { display: flex; flex-direction: column; gap: 0.5rem; }
  .numeros dt { color: var(--color-ink-muted); }
</style>
