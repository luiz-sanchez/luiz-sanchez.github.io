---
import { servicos, servicosIntro } from '../data/servicos';
---
<section id="servicos" class="claro pb-20 sm:pb-28 lg:pb-36" aria-labelledby="servicos-titulo">
  <div class="container-x">
    <div class="reveal">
      <h2 id="servicos-titulo" class="text-[2.2rem] leading-[1.05] sm:text-[2.8rem] lg:text-[3.1rem]">{servicosIntro.titulo}</h2>
    </div>

    <!-- Índice tipográfico: o nome da frente no mesmo corte do nome do hero -->
    <ul class="indice mt-10 lg:mt-14">
      {servicos.map((s, i) => (
        <li class="linha reveal" style={`--d:${i * 50}ms`}>
          <div class="caixa"><h3 class="frente" data-mask>{s.titulo}</h3></div>
          <p class="desc">{s.descricao}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .indice { border-bottom: 1px solid var(--color-line); }
  .linha {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 0 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .frente {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 900;
    font-stretch: 80%;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: -0.01em;
    /* Cabe a palavra mais longa ("Desenvolvimento") na coluna */
    font-size: min(4.6rem, 10.4cqi);
    color: var(--color-on-dark);
  }
  .caixa { container-type: inline-size; min-width: 0; }
  .desc {
    max-width: 40ch;
    color: var(--color-muted);
    line-height: 1.6;
  }
  @media (min-width: 1024px) {
    .linha {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      align-items: center;
      gap: 2rem;
      padding: 1.25rem 0 1.4rem;
    }
    .desc { font-size: 1.05rem; }
  }
  @media (min-width: 1280px) {
    .linha { grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); }
  }
</style>
