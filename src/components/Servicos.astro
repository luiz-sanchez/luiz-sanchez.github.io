---
import { servicos, servicosIntro } from '../data/servicos';
---
<section id="servicos" class="pb-20 sm:pb-28 lg:pb-36" aria-labelledby="servicos-titulo">
  <div class="container-x">
    <div class="reveal">
      <h2 id="servicos-titulo" class="text-[2.2rem] leading-[1.05] sm:text-[2.8rem] lg:text-[3.1rem]">{servicosIntro.titulo}</h2>
    </div>

    <!-- Lista de frentes: nome em itálico de display, descrição ao lado -->
    <ul class="indice mt-10 lg:mt-14">
      {servicos.map((s, i) => (
        <li class="linha reveal" style={`--d:${i * 50}ms`}>
          <h3 class="frente">{s.titulo}</h3>
          <p class="desc">{s.descricao}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .indice { border-bottom: 1px solid var(--color-line); }
  .linha {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 0 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .frente {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 900;
    font-stretch: 100%;
    line-height: 1.05;
    letter-spacing: -0.015em;
    /* Em caixa normal e menor: a letra gigante fica para o hero, os projetos e o contato */
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
    color: var(--color-on-dark);
  }
  .desc {
    max-width: 40ch;
    color: var(--color-muted);
    line-height: 1.6;
  }
  /* Nome numa coluna estreita, descrição logo ao lado: sem buraco no meio */
  @media (min-width: 768px) {
    .linha {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      align-items: baseline;
      gap: 2rem;
      padding: 1.3rem 0 1.4rem;
    }
    .desc { font-size: 1.05rem; }
  }
  @media (min-width: 1024px) {
    .linha { grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); }
  }
</style>
