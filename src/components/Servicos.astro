---
import { servicos, servicosIntro } from '../data/servicos';

// Um tom por frente: degradê pastel de fundo e a mesma cor, mais escura, no título
const tons = [
  ['#e8f1ff', '#d6e4ff', '#0055b3'],
  ['#eeeaff', '#ddd6ff', '#4b3fd0'],
  ['#f6eaff', '#ead6ff', '#7a2fb8'],
  ['#ffeaf3', '#ffd6e6', '#a8285d'],
  ['#fff1e3', '#ffe1c2', '#9a4a00'],
  ['#e6f8f3', '#ccefe5', '#0b6a50'],
];
---
<section id="servicos" class="pt-20 pb-20 sm:pt-28 sm:pb-28 lg:pt-32 lg:pb-36" aria-labelledby="servicos-titulo">
  <div class="container-x">
    <div class="reveal">
      <h2 id="servicos-titulo" class="text-[2.2rem] leading-[1.05] sm:text-[2.8rem] lg:text-[3.1rem]">{servicosIntro.titulo}</h2>
    </div>

    <!-- Frentes em cards de superfície 1: 3 por linha no computador, 2 no tablet, 1 no celular -->
    <ul class="grade mt-10 lg:mt-14">
      {servicos.map((s, i) => (
        <li class="card reveal" style={`--d:${(i % 3) * 60}ms;--de:${tons[i % 6][0]};--ate:${tons[i % 6][1]};--tom:${tons[i % 6][2]}`}>
          <h3 class="frente">{s.titulo}</h3>
          <p class="desc">{s.descricao}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grade { display: grid; gap: 12px; }
  @media (min-width: 640px) { .grade { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .grade { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .card {
    position: relative;
    padding: 24px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--de), var(--ate));
  }
  .frente {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--tom);
  }
  .desc {
    margin-top: 0.6rem;
    max-width: 40ch;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
</style>
