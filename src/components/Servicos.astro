---
import { servicos, servicosIntro } from '../data/servicos';
---
<section id="servicos" class="pt-20 pb-20 sm:pt-28 sm:pb-28 lg:pt-32 lg:pb-36" aria-labelledby="servicos-titulo">
  <div class="container-x">
    <div class="reveal">
      <h2 id="servicos-titulo" class="text-[2.2rem] leading-[1.05] sm:text-[2.8rem] lg:text-[3.1rem]">{servicosIntro.titulo}</h2>
    </div>

    <!-- Frentes em cards de superfície 1: 3 por linha no computador, 2 no tablet, 1 no celular -->
    <ul class="grade mt-10 lg:mt-14">
      {servicos.map((s, i) => (
        <li class="card reveal" style={`--d:${(i % 3) * 60}ms`}>
          <h3 class="frente">{s.titulo}</h3>
          <p class="desc">{s.descricao}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grade { display: grid; gap: 12px; }
  @media (min-width: 640px) { .grade { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .grade { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .card {
    position: relative;
    padding: 24px;
    border-radius: 18px;
    background: var(--color-night-2);
    transition: background-color var(--dur-ui) var(--expo);
  }
  .card:hover { background: var(--color-night-4); }
  .frente {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--color-on-dark);
  }
  .desc {
    margin-top: 0.6rem;
    max-width: 40ch;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
</style>
