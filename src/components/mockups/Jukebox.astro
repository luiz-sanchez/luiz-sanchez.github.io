---
import { jukeboxMock as m } from '../../data/projetos';
---
<div class="relative mx-auto flex justify-center py-4">
  <!-- brilho suave atrás do celular, igual ao do hero -->
  <span class="pointer-events-none absolute left-1/2 top-1/2 aspect-square w-[min(460px,110%)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(closest-side,rgb(45_98_234/0.45),rgb(45_98_234/0.12)_60%,transparent)]" aria-hidden="true"></span>

  <div class="phone relative" role="img" aria-label="Ilustração do Jukebox: festa #4821, música tocando agora, fila com pedidos da Ana e do Rafa e botão para adicionar música">
    <div aria-hidden="true">
      <span class="mx-auto mb-4 block h-1.5 w-16 rounded-full bg-white/15"></span>
      <div class="flex items-center justify-between">
        <p class="text-[1.05rem] font-bold text-white">Jukebox</p>
        <span class="rounded-full bg-green px-2.5 py-0.5 text-[0.75rem] font-bold text-ink">{m.codigo}</span>
      </div>

      <div class="mt-4 rounded-xl bg-accent-deep p-3">
        <p class="text-[0.75rem] text-white">{m.tocando}</p>
        <div class="mt-2 aspect-[16/9] rounded-lg bg-[linear-gradient(135deg,#7c9cf5_0%,#3fb6a8_55%,#22c55e_100%)]"></div>
        <p class="mt-3 text-[0.85rem] font-bold text-white">{m.faixa}</p>
        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/25">
          <span class="progress block h-full rounded-full bg-white"></span>
        </div>
      </div>

      <p class="mt-4 text-[0.75rem] text-on-dark-muted">{m.filaTitulo}</p>
      <ul class="mt-2 space-y-2">
        {m.fila.map((f, i) => (
          <li class="flex items-center gap-3">
            <span class={`size-8 rounded-md ${i === 0 ? 'bg-[#3b4a7a]' : 'bg-ink-3'}`}></span>
            <span class="text-[0.82rem] text-white">{f}</span>
          </li>
        ))}
      </ul>

      <p class="mt-4 rounded-lg bg-green py-2.5 text-center text-[0.85rem] font-bold text-ink">{m.botao}</p>
    </div>
  </div>
</div>

<style>
  .phone {
    width: min(270px, 82vw);
    padding: 14px 16px 18px;
    border-radius: 34px;
    background: #191b21;
    border: 7px solid #2a2e37;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
  }
  .progress { width: 12%; transition: width 6s linear 0.4s; }
  :global(.is-in) .progress { width: 68%; }
  :global(.no-js) .progress { width: 60%; }
  @media (prefers-reduced-motion: reduce) { .progress { width: 60%; } }
</style>
