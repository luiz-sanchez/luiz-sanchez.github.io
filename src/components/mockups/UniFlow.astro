---
import { uniflowMock as m } from '../../data/projetos';
const max = Math.max(...m.grafico.barras);
---
<div class="win uf" role="img" aria-label="Ilustração do UniFlow: painel com 18 chamados abertos, 7 em andamento, 142 resolvidos e gráfico de chamados por semana">
  <div class="win-bar" aria-hidden="true">
    <span class="dot bg-[#ff5f57]"></span><span class="dot bg-[#febc2e]"></span><span class="dot bg-[#28c840]"></span>
    <span class="url">{m.url}</span>
  </div>
  <div class="grid grid-cols-[minmax(0,92px)_1fr] sm:grid-cols-[minmax(0,120px)_1fr]" aria-hidden="true">
    <aside class="border-r border-white/5 p-3 sm:p-4">
      <p class="mb-3 flex items-center gap-1.5 text-[0.9rem] font-bold text-white">
        <span class="grid size-5 place-items-center rounded-[5px] bg-[#1a62c0]"><span class="size-2 rounded-full border-[1.5px] border-white"></span></span>
        <span>Uni<span class="text-[#4ea1f5]">FLOW</span></span>
      </p>
      <ul class="space-y-1 text-[0.72rem] sm:text-[0.8rem]">
        {m.menu.map((item, i) => (
          <li class={i === 0 ? 'rounded-md bg-[#1a62c0] px-2 py-1.5 font-semibold text-white' : 'px-2 py-1.5 text-on-dark-muted'}>{item}</li>
        ))}
      </ul>
    </aside>
    <div class="space-y-3 p-3 sm:p-4">
      <div class="grid grid-cols-3 gap-2 sm:gap-3">
        {m.cards.map((c) => (
          <div class={`rounded-lg p-2.5 sm:p-3 ${c.tom === 'azul' ? 'bg-[#1a62c0]' : 'bg-[#112640]'}`}>
            <p class={`text-[0.66rem] sm:text-[0.75rem] ${c.tom === 'azul' ? 'text-white' : 'text-on-dark-muted'}`}>{c.rotulo}</p>
            <p class={`mt-1 text-xl font-bold sm:text-2xl ${c.tom === 'amarelo' ? 'text-yellow' : 'text-white'}`}>{c.valor}</p>
          </div>
        ))}
      </div>
      <div class="rounded-lg bg-[#112640] p-3">
        <p class="text-[0.7rem] text-on-dark-muted sm:text-[0.78rem]">{m.grafico.titulo}</p>
        <div class="bars mt-3 flex h-24 items-end gap-1.5 sm:h-28 sm:gap-2.5">
          {m.grafico.barras.map((b, i) => (
            <span
              class="bar flex-1 rounded-t-[4px]"
              style={`height:${(b / max) * 100}%;--i:${i};background:${i === m.grafico.destaque ? '#2f86e0' : i === m.grafico.barras.length - 1 ? '#7cc0ff' : '#24405f'}`}
            ></span>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Cores do UniFlow real (azul-marinho), não do portfólio */
  .uf { background: #0a1828; border-color: rgb(78 161 245 / 0.14); }
  .uf :global(.win-bar .url) { background: #112640; }
  .bar { transform-origin: bottom; transform: scaleY(0.04); transition: transform 0.9s var(--ease-out-soft); transition-delay: calc(var(--i) * 70ms + 150ms); }
  :global(.is-in) .bar, :global(.no-js) .bar { transform: none; }
  @media (prefers-reduced-motion: reduce) { .bar { transform: none; } }
</style>
