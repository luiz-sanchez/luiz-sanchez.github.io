---
// Boneco estilo cartoon 3D do Luiz, desenhado em SVG (sem imagem externa).
// Volume feito com gradientes radiais; cores tiradas da foto de referência.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;

// Cachos gerados de forma determinística ao redor do topo da cabeça.
const rnd = (i: number) => { const x = Math.sin(i * 12.9898) * 43758.5453; return x - Math.floor(x); };
type Cacho = { x: number; y: number; r: number; a: number };
const cachos: Cacho[] = [];
// Contorno (silhueta) do volume
for (let i = 0; i < 26; i++) {
  const t = Math.PI * (1.02 + (i / 25) * 0.96);
  const rx = 112 + rnd(i) * 8, ry = 74 + rnd(i + 50) * 8;
  cachos.push({ x: 200 + Math.cos(t) * rx, y: 150 + Math.sin(t) * ry, r: 15 + rnd(i + 9) * 6, a: rnd(i + 3) * 360 });
}
// Preenchimento interno
for (let i = 0; i < 34; i++) {
  const x = 112 + rnd(i + 100) * 176, y = 92 + rnd(i + 200) * 62;
  if (((x - 200) / 108) ** 2 + ((y - 150) / 70) ** 2 < 1) cachos.push({ x, y, r: 12 + rnd(i + 300) * 5, a: rnd(i + 400) * 360 });
}
// Franja que cai sobre a testa
for (let i = 0; i < 9; i++) cachos.push({ x: 128 + i * 18 + rnd(i + 500) * 6, y: 150 + Math.sin(i / 8 * Math.PI) * 4 + rnd(i + 600) * 6, r: 11 + rnd(i + 700) * 4, a: rnd(i + 800) * 360 });
---
<svg class={cls} viewBox="0 0 400 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="avatar-titulo">
  <title id="avatar-titulo">Ilustração do Luiz em estilo cartoon</title>
  <defs>
    <radialGradient id="av-pele" cx="0.42" cy="0.36" r="0.75">
      <stop offset="0" stop-color="#e8b38b" />
      <stop offset="0.55" stop-color="#cf946b" />
      <stop offset="1" stop-color="#a86d48" />
    </radialGradient>
    <radialGradient id="av-pele-orelha" cx="0.5" cy="0.4" r="0.7">
      <stop offset="0" stop-color="#d9a079" />
      <stop offset="1" stop-color="#9c6341" />
    </radialGradient>
    <linearGradient id="av-pescoco" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9a6240" />
      <stop offset="0.45" stop-color="#c2875f" />
    </linearGradient>
    <radialGradient id="av-moletom" cx="0.5" cy="0.15" r="0.95">
      <stop offset="0" stop-color="#d9d0c3" />
      <stop offset="0.6" stop-color="#bfb4a5" />
      <stop offset="1" stop-color="#9c9182" />
    </radialGradient>
    <radialGradient id="av-cabelo" cx="0.45" cy="0.3" r="0.7">
      <stop offset="0" stop-color="#3a2a20" />
      <stop offset="1" stop-color="#160f0b" />
    </radialGradient>
    <radialGradient id="av-iris" cx="0.5" cy="0.45" r="0.6">
      <stop offset="0" stop-color="#9fc2f0" />
      <stop offset="0.55" stop-color="#5a8ed3" />
      <stop offset="1" stop-color="#2c5596" />
    </radialGradient>
    <radialGradient id="av-labio" cx="0.5" cy="0.35" r="0.7">
      <stop offset="0" stop-color="#d08e80" />
      <stop offset="1" stop-color="#a5604f" />
    </radialGradient>
    <filter id="av-blur"><feGaussianBlur stdDeviation="2.5" /></filter>
    <filter id="av-sombra" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#0b1a4a" flood-opacity="0.35" />
    </filter>
  </defs>

  <g filter="url(#av-sombra)">
    <!-- Moletom -->
    <path d="M40 480 C44 410 86 372 150 356 L250 356 C314 372 356 410 360 480 Z" fill="url(#av-moletom)" />
    <path d="M150 356 C170 384 230 384 250 356" fill="none" stroke="#a89d8e" stroke-width="3" />

    <!-- Pescoço -->
    <path d="M162 300 L238 300 L242 360 C222 378 178 378 158 360 Z" fill="url(#av-pescoco)" />
    <!-- Gola canelada -->
    <path d="M150 352 C170 376 230 376 250 352 C246 368 232 382 200 384 C168 382 154 368 150 352 Z" fill="#cfc5b7" stroke="#b1a696" stroke-width="2" />

    <!-- Orelhas -->
    <ellipse cx="96" cy="222" rx="20" ry="28" fill="url(#av-pele-orelha)" />
    <ellipse cx="304" cy="222" rx="20" ry="28" fill="url(#av-pele-orelha)" />
    <path d="M92 210 C100 218 100 230 94 238" fill="none" stroke="#8f5838" stroke-width="3" stroke-linecap="round" opacity="0.5" />
    <path d="M308 210 C300 218 300 230 306 238" fill="none" stroke="#8f5838" stroke-width="3" stroke-linecap="round" opacity="0.5" />

    <!-- Rosto -->
    <path d="M200 92 C276 92 306 150 306 214 C306 282 262 330 200 330 C138 330 94 282 94 214 C94 150 124 92 200 92 Z" fill="url(#av-pele)" />
    <!-- Sombra do cabelo na testa -->
    <path d="M110 160 C150 140 250 140 290 160 C280 150 240 138 200 138 C160 138 120 150 110 160 Z" fill="#7a4a30" opacity="0.25" />

    <!-- Cabelo cacheado: massa + cachos com espiral -->
    <path d="M96 206 C88 150 120 80 200 76 C280 80 312 150 304 206 C296 186 292 168 282 160 C250 146 150 146 118 160 C108 168 104 186 96 206 Z" fill="#1a120d" />
    <g>
      {cachos.map((c) => (
        <g transform={`translate(${c.x.toFixed(1)} ${c.y.toFixed(1)}) rotate(${c.a.toFixed(0)})`}>
          <circle r={c.r.toFixed(1)} fill="url(#av-cabelo)" />
          <path d={`M${(-c.r * 0.55).toFixed(1)} 0 A${(c.r * 0.55).toFixed(1)} ${(c.r * 0.55).toFixed(1)} 0 1 1 ${(c.r * 0.2).toFixed(1)} ${(c.r * 0.45).toFixed(1)}`} fill="none" stroke="#5b4333" stroke-width="2.2" stroke-linecap="round" opacity="0.7" />
        </g>
      ))}
    </g>

    <!-- Sobrancelhas grossas -->
    <path d="M128 186 C142 174 166 172 184 180 L182 188 C166 183 146 184 132 192 Z" fill="#24180f" />
    <path d="M272 186 C258 174 234 172 216 180 L218 188 C234 183 254 184 268 192 Z" fill="#24180f" />

    <!-- Olhos -->
    <g>
      <ellipse cx="158" cy="214" rx="24" ry="18" fill="#fbf8f4" />
      <ellipse cx="242" cy="214" rx="24" ry="18" fill="#fbf8f4" />
      <circle cx="160" cy="216" r="13" fill="url(#av-iris)" />
      <circle cx="240" cy="216" r="13" fill="url(#av-iris)" />
      <circle cx="160" cy="216" r="6" fill="#0f1420" />
      <circle cx="240" cy="216" r="6" fill="#0f1420" />
      <circle cx="155" cy="211" r="4" fill="#fff" />
      <circle cx="235" cy="211" r="4" fill="#fff" />
      <circle cx="165" cy="221" r="1.8" fill="#fff" opacity="0.8" />
      <circle cx="245" cy="221" r="1.8" fill="#fff" opacity="0.8" />
      <!-- Pálpebras (olhar calmo) -->
      <path d="M132 210 C142 196 176 194 184 208 C176 202 144 202 132 210 Z" fill="#9b6240" />
      <path d="M268 210 C258 196 224 194 216 208 C224 202 256 202 268 210 Z" fill="#9b6240" />
      <path d="M133 209 C146 199 172 199 183 207" fill="none" stroke="#2a1b12" stroke-width="3.2" stroke-linecap="round" />
      <path d="M267 209 C254 199 228 199 217 207" fill="none" stroke="#2a1b12" stroke-width="3.2" stroke-linecap="round" />
    </g>

    <!-- Nariz -->
    <path d="M204 222 C206 238 212 250 214 256" fill="none" stroke="#a86d48" stroke-width="2.5" stroke-linecap="round" opacity="0.45" />
    <ellipse cx="200" cy="254" rx="18" ry="12" fill="#d79f77" />
    <ellipse cx="196" cy="249" rx="7" ry="4" fill="#f0c3a0" opacity="0.7" />
    <path d="M184 258 C188 264 194 264 196 262 M216 258 C212 264 206 264 204 262" fill="none" stroke="#7a4428" stroke-width="2.4" stroke-linecap="round" opacity="0.7" />

    <!-- Bochechas -->
    <ellipse cx="134" cy="252" rx="18" ry="10" fill="#e08a7a" opacity="0.18" />
    <ellipse cx="266" cy="252" rx="18" ry="10" fill="#e08a7a" opacity="0.18" />

    <!-- Bigode fino -->
    <path d="M174 278 C186 271 196 272 200 274 C204 272 214 271 226 278 C214 276 206 277 200 279 C194 277 186 276 174 278 Z" fill="#2b1d14" opacity="0.7" />

    <!-- Lábios -->
    <path d="M172 284 C184 278 194 280 200 282 C206 280 216 278 228 284 C220 290 210 292 200 292 C190 292 180 290 172 284 Z" fill="url(#av-labio)" />
    <path d="M176 288 C186 300 214 300 224 288 C214 292 186 292 176 288 Z" fill="#b8705f" />
    <path d="M186 296 C194 300 206 300 214 296" fill="none" stroke="#e7b0a0" stroke-width="2" stroke-linecap="round" opacity="0.6" />

    <!-- Cavanhaque -->
    <path d="M184 306 C192 302 208 302 216 306 C218 318 210 330 200 332 C190 330 182 318 184 306 Z" fill="#24180f" opacity="0.88" />
    <!-- Barba rala: sombra suave na mandíbula -->
    <path d="M120 262 C134 304 164 328 200 330 C236 328 266 304 280 262 C268 296 238 318 200 320 C162 318 132 296 120 262 Z" fill="#3a281c" opacity="0.22" filter="url(#av-blur)" />
  </g>
</svg>
