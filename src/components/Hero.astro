---
import { ArrowDown, MapPin } from '@lucide/astro';
import { site } from '../data/site';
---
<section id="inicio" class="hero relative isolate overflow-hidden lg:min-h-[100svh]" aria-labelledby="hero-titulo">
  <div class="container-x relative z-10 flex flex-col pt-28 pb-10 sm:pt-32 lg:min-h-[100svh] lg:justify-center lg:pb-24 lg:pt-24">
    <p class="eyebrow hero-in" style="--d:0ms">{site.eyebrow}</p>

    <h1 id="hero-titulo" class="hero-title mt-5 font-display font-extrabold text-ink">
      <span class="hero-in block" style="--d:80ms">Luiz</span>
      <span class="hero-in block" style="--d:160ms">Sanchez</span>
    </h1>

    <span class="hero-in mt-7 block h-[5px] w-16 rounded-full bg-blue" style="--d:240ms" aria-hidden="true"></span>

    <p class="hero-in mt-7 max-w-[30ch] text-[1.2rem] leading-relaxed text-muted sm:text-[1.35rem] lg:max-w-[34ch]" style="--d:300ms">
      {site.subtitulo}
    </p>

    <div class="hero-in mt-9 flex flex-wrap gap-3" style="--d:380ms">
      <a href="#projetos" class="btn btn-primary">
        {site.ctas.projetos}
        <ArrowDown class="size-4" aria-hidden="true" />
      </a>
      <a href="#contato" class="btn btn-ghost">{site.ctas.contato}</a>
    </div>

    <p class="hero-in mt-10 flex items-center gap-1.5 text-sm text-muted lg:absolute lg:bottom-10 lg:mt-0" style="--d:440ms">
      <MapPin class="size-4" aria-hidden="true" />
      {site.local}
    </p>
  </div>

  <!-- Bloco azul com o monograma -->
  <div
    class="hero-panel bg-blue-grad on-blue relative mx-5 mb-6 h-[340px] overflow-hidden rounded-[var(--radius-card)] sm:mx-8 sm:h-[420px] lg:absolute lg:inset-y-0 lg:right-0 lg:m-0 lg:h-auto lg:w-[38vw] lg:rounded-none"
    data-parallax
  >
    <span class="circle circle-a" data-depth="10" aria-hidden="true"></span>
    <span class="circle circle-b" data-depth="-16" aria-hidden="true"></span>
    <span class="circle circle-c" data-depth="22" aria-hidden="true"></span>
    <span class="monogram font-display" data-depth="-8" aria-hidden="true">LS</span>

    <ul class="absolute bottom-6 left-6 right-6 flex flex-wrap gap-2 lg:bottom-[22%] lg:left-[10%]" aria-label="Áreas principais">
      {site.heroTags.map((t) => <li class="pill pill-white">{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero-title {
    font-size: clamp(4.2rem, 17vw, 12.5rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }
  @media (min-width: 1024px) {
    .hero-title { font-size: clamp(7rem, 12.2vw, 12.5rem); }
  }

  .hero-panel { --mx: 0; --my: 0; }
  .hero-panel [data-depth] {
    transform: translate3d(calc(var(--mx) * var(--k, 0px)), calc(var(--my) * var(--k, 0px)), 0);
    transition: transform 0.6s var(--ease-out-soft);
    will-change: transform;
  }
  .circle { position: absolute; border-radius: 9999px; pointer-events: none; }
  .circle-a { width: 62%; aspect-ratio: 1; top: 8%; right: -6%; border: 1.5px solid rgb(255 255 255 / 0.35); }
  .circle-b { width: 46%; aspect-ratio: 1; top: 44%; left: 6%; background: rgb(255 255 255 / 0.12); }
  .circle-c { width: 9%; aspect-ratio: 1; top: 12%; right: 12%; background: rgb(255 255 255 / 0.9); }
  .monogram {
    position: absolute;
    left: 14%;
    top: 9%;
    font-size: clamp(8rem, 42vw, 15rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    color: #fff;
  }
  @media (min-width: 640px) { .monogram { font-size: 16rem; top: 6%; } }
  @media (min-width: 1024px) {
    .monogram { font-size: clamp(12rem, 17vw, 19rem); top: 42%; margin-top: -0.6em; left: 12%; }
    .circle-c { width: 6%; top: 64%; right: 16%; }
  }

  .hero-in { opacity: 0; transform: translateY(16px); animation: hero-in 0.9s var(--ease-out-soft) forwards; animation-delay: var(--d); }
  .hero-panel { animation: panel-in 1.1s var(--ease-out-soft) both; }
  @keyframes hero-in { to { opacity: 1; transform: none; } }
  @keyframes panel-in { from { clip-path: inset(0 0 0 100%); } to { clip-path: inset(0 0 0 0); } }
  @media (prefers-reduced-motion: reduce) {
    .hero-in { opacity: 1; transform: none; animation: none; }
    .hero-panel { animation: none; }
  }
</style>
