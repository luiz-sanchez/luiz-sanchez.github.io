---
import { ArrowRight, ArrowDown } from '@lucide/astro';
import { site } from '../data/site';

// Nome em letras separadas para a revelação; o texto completo fica no .sr-only.
const palavras = site.nome.split(' ');
let n = 0;
const letras = palavras.map((p) => [...p].map((ch) => ({ ch, i: n++ })));
const frase = site.frase.replace(/\*\*(.+?)\*\*/g, '<strong class="destaque">$1</strong>');
---
<section id="inicio" class="hero relative isolate overflow-hidden" aria-labelledby="hero-titulo" data-parallax>
  <!-- Fundo: brilho azul atrás do avatar e arcos finos (afunda e esmaece ao rolar) -->
  <div class="hero-bg" aria-hidden="true">
  <span class="glow"></span>
  <span class="layer" data-depth="18">
    <svg class="arcs" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" fill="none">
      <path d="M-100 980 C 300 640, 1100 560, 1700 700" stroke="url(#arc-a)" stroke-width="1.5" />
      <path d="M-100 1060 C 420 760, 1200 700, 1700 860" stroke="url(#arc-b)" stroke-width="1" />
      <defs>
        <linearGradient id="arc-a" x1="0" x2="1"><stop offset="0" stop-color="#2d62ea" stop-opacity="0" /><stop offset=".5" stop-color="#3b82f6" stop-opacity=".7" /><stop offset="1" stop-color="#38bdf8" stop-opacity="0" /></linearGradient>
        <linearGradient id="arc-b" x1="0" x2="1"><stop offset="0" stop-color="#2d62ea" stop-opacity="0" /><stop offset=".6" stop-color="#7aa7ff" stop-opacity=".35" /><stop offset="1" stop-color="#2d62ea" stop-opacity="0" /></linearGradient>
      </defs>
    </svg>
  </span>
  </div>

  <div class="hero-inner relative mx-auto w-full max-w-[1440px] px-5 pt-28 sm:px-8 sm:pt-32 lg:px-12 lg:pt-36">
    <h1 id="hero-titulo" class="relative z-[1]">
      <span class="saudacao fade-up block" style="--d:80ms">{site.saudacao}</span>
      <span class="sr-only">{site.nome}</span>
      <span class="layer-flat" data-depth="-8">
        <span class="nome block" aria-hidden="true">
          {letras.map((p) => (
            <span class="palavra">{p.map(({ ch, i }) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}</span>
          ))}
        </span>
      </span>
    </h1>

    <div class="textos relative z-[3] grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
      <div class="intro fade-up border-l-2 pl-5 sm:pl-6" style="--d:520ms">
        <p class="text-[1.15rem] leading-snug text-on-dark sm:text-[1.3rem] lg:text-[1.45rem]">{site.subtitulo}</p>
        <p class="mt-4 text-[1.15rem] leading-snug text-on-dark sm:text-[1.3rem] lg:text-[1.45rem]" set:html={frase} />
      </div>

      <div class="acoes fade-up flex flex-wrap items-center gap-x-6 gap-y-4" style="--d:600ms">
        <a href="#contato" class="cta-hero group">
          {site.ctas.contato}
          <ArrowRight class="size-6 transition-transform duration-(--dur-ui) ease-(--expo) group-hover:translate-x-1" aria-hidden="true" />
        </a>
        <a href="#projetos" class="ver-projetos group inline-flex min-h-12 items-center gap-2 text-[1.02rem] font-semibold text-white underline decoration-white/30 underline-offset-[6px] transition-colors duration-(--dur-ui) hover:decoration-sky">
          {site.ctas.projetos}
          <ArrowDown class="size-4 transition-transform duration-(--dur-ui) ease-(--expo) group-hover:translate-y-0.5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>

  <!-- Avatar na frente do nome -->
  <div class="avatar-wrap">
    <span class="layer-flat" data-depth="8">
      <img
        class="avatar block h-auto w-full"
        src="/avatar/luiz.webp"
        srcset="/avatar/luiz-440.webp 440w, /avatar/luiz.webp 720w"
        sizes="(min-width: 1024px) min(44vw, 74vh, 700px), min(92vw, 440px)"
        width="720"
        height="890"
        alt="Avatar 3D do Luiz"
        decoding="async"
        fetchpriority="high"
      />
    </span>
  </div>
</section>

<style>
  .hero {
    --expo: cubic-bezier(0.16, 1, 0.3, 1);
    --back: cubic-bezier(0.34, 1.4, 0.64, 1);
    --mx: 0;
    --my: 0;
    /* tamanhos do nome, usados também para posicionar o avatar no desktop */
    --S: clamp(1.3rem, 3.4vw, 2.5rem);
    --F: calc((min(100vw, 1440px) - 112px) / 6.8);
    display: flex;
    flex-direction: column;
    background: var(--color-night);
  }
  @media (min-width: 1024px) {
    .hero { min-height: max(100svh, 760px); }
  }

  /* ---------- Fundo ---------- */
  .glow {
    position: absolute;
    left: 50%;
    bottom: -18%;
    width: min(1100px, 140vw);
    aspect-ratio: 1.6;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgb(45 98 234 / 0.55), rgb(45 98 234 / 0.18) 55%, transparent);
    pointer-events: none;
  }
  .arcs { position: absolute; inset: 0; width: 100%; height: 100%; }
  .layer, .layer-flat { transform: translate3d(calc(var(--mx) * var(--k, 0px)), calc(var(--my) * var(--k, 0px)), 0); }
  .layer { position: absolute; inset: 0; pointer-events: none; }
  .layer-flat { display: block; }

  /* ---------- Nome gigante ---------- */
  .saudacao {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 700;
    font-size: var(--S);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: rgb(236 235 242 / 0.82);
    margin-left: 0.08em;
  }
  .nome {
    margin-top: 0.08em;
    font-stretch: 80%;
    text-transform: uppercase;
    /* "SANCHEZ" mede ~4,4em: ocupa a largura toda no celular */
    font-size: min(calc((100vw - 40px) / 4.55), 9rem);
    line-height: 0.86;
    white-space: nowrap;
  }
  .palavra { display: block; overflow: hidden; padding: 0.02em 0.12em 0.04em 0; margin-right: -0.12em; }
  .ch {
    display: inline-block;
    background: linear-gradient(180deg, #ffffff 0%, #e4e2ea 55%, #b9b6c4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (min-width: 1024px) {
    /* "LUIZ SANCHEZ" mede ~6,7em: ocupa a largura do container */
    .nome { font-size: var(--F); }
    .palavra { display: inline-block; }
    .palavra + .palavra { margin-left: 0.22em; }
  }

  /* ---------- Textos e botão ---------- */
  .intro { border-color: var(--color-accent); max-width: 30ch; }
  .intro :global(.destaque) {
    font-weight: 700;
    background: linear-gradient(90deg, #7aa7ff, #7dd3fc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .textos { margin-top: 2rem; }
  .acoes { justify-self: start; }
  .cta-hero {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    min-height: 64px;
    padding: 0 1.8rem 0 2.1rem;
    border: 1.5px solid transparent;
    border-radius: 9999px;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    background:
      linear-gradient(90deg, #0b1530 0%, #102a63 55%, #1d4ed8 88%, #1e40af 100%) padding-box,
      linear-gradient(90deg, #2d62ea, #38bdf8 60%, #67e8f9) border-box;
    box-shadow: 0 0 40px -12px rgb(14 165 233 / 0.7);
    transition: box-shadow var(--dur-ui) var(--expo), transform var(--dur-ui) var(--expo);
  }
  .cta-hero:hover { box-shadow: 0 0 56px -10px rgb(56 189 248 / 0.85); }
  .cta-hero:active { transform: scale(0.97); transition-duration: var(--dur-fast); }

  /* ---------- Avatar ---------- */
  .avatar-wrap {
    /* a base reta do busto some no fundo escuro */
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 99%);
    mask-image: linear-gradient(to bottom, #000 78%, transparent 99%);
    position: relative;
    z-index: 2;
    width: min(92%, 440px);
    margin: 2.5rem auto 0;
  }
  @media (min-width: 640px) { .avatar-wrap { width: min(70%, 520px); } }
  @media (min-width: 1024px) {
    .hero-inner { flex: 1; display: flex; flex-direction: column; }
    .textos { margin-top: auto; padding-bottom: 18vh; }
    .acoes { justify-self: end; flex-direction: column; align-items: flex-end; }
    /* Composição da referência: o cabelo começa acima do nome e os olhos ficam na faixa das letras,
       com o avatar na frente do nome. O busto vai até o fim da tela e some no degradê do ::after.
       Limites: 1100px de altura e 54vw (largura ≈ 44vw) para não encostar no texto e no botão. */
    .avatar-wrap {
      --av-top: max(6.5rem, calc(9rem + var(--S) - 0.35 * var(--F)));
      position: absolute;
      left: 50%;
      top: var(--av-top);
      height: min(calc(100% - var(--av-top)), 1100px, 54vw);
      width: auto;
      margin: 0;
      transform: translateX(-50%);
    }
    .avatar-wrap > .layer-flat { height: 100%; }
    .avatar { height: 100%; width: auto; max-width: none; }
    .hero::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 22vh;
      z-index: 2;
      background: linear-gradient(to bottom, transparent, var(--color-night));
      pointer-events: none;
    }
  }

  /* ---------- Entrada (uma sequência só) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .ch { animation: rise 1s var(--expo) both; animation-delay: calc(120ms + var(--i) * 32ms); }
    .glow { animation: glow-in 1.6s var(--expo) 0.2s both; }
    .avatar { animation: avatar-in 1.2s var(--back) 0.45s both; transform-origin: 50% 100%; }
    .arcs path { stroke-dasharray: 2200; animation: draw 2.2s var(--expo) 0.5s both; }
    .fade-up { animation: fade-up 0.7s var(--expo) both; animation-delay: var(--d); }
  }

  /* ---------- Saída ligada à rolagem (só camadas decorativas e a imagem; o texto fica parado) ---------- */
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      /* longhands de propósito: o minificador não pode juntá-los num atalho que perderia o timeline */
      .hero-bg, .avatar-wrap {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .hero-bg { animation-name: bg-exit; }
      .avatar-wrap { animation-name: avatar-exit; }
    }
  }
  @keyframes bg-exit { to { translate: 0 14%; opacity: 0.25; } }
  @keyframes avatar-exit { to { translate: 0 -7%; scale: 0.96; } }

  @keyframes rise { from { transform: translateY(105%) skewX(-8deg); } to { transform: none; } }
  @keyframes avatar-in { from { transform: translateY(40%) scale(0.94); } to { transform: none; } }
  @keyframes glow-in { from { opacity: 0; transform: translateX(-50%) scale(0.7); } to { opacity: 1; transform: translateX(-50%); } }
  @keyframes draw { from { stroke-dashoffset: 2200; } to { stroke-dashoffset: 0; } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
</style>
