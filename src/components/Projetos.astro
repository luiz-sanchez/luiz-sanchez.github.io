---
import { ExternalLink } from '@lucide/astro';
import { projetos, projetosIntro } from '../data/projetos';
import UniFlow from './mockups/UniFlow.astro';
import Jukebox from './mockups/Jukebox.astro';
import Glpi from './mockups/Glpi.astro';

const mockups = { uniflow: UniFlow, jukebox: Jukebox, glpi: Glpi };
---
<section id="projetos" class="proj-shell on-dark text-on-dark" aria-labelledby="projetos-titulo" data-expand>
  <!-- Título no mesmo tamanho das outras seções: os nomes dos projetos já são a letra grande aqui -->
  <div class="reveal container-x pt-16 sm:pt-20 lg:pt-24">
    <h2 id="projetos-titulo" class="text-[2.2rem] leading-[1.05] text-white sm:text-[2.8rem] lg:text-[3.1rem]">{projetosIntro.titulo}</h2>
  </div>

  {projetos.map((p, i) => {
    const Mockup = mockups[p.mockup];
    return (
      <article
        id={`projeto-${p.id}`}
        class="projeto relative overflow-hidden border-t border-white/[0.06] py-14 sm:py-20 lg:py-24"
        aria-labelledby={`projeto-${p.id}-titulo`}
      >
        <div class="container-x relative">
          <!-- Nome do projeto no corte do hero, como uma linha do índice de Serviços -->
          <header class="reveal cabeca">
            <div class="caixa">
              <h3 id={`projeto-${p.id}-titulo`} class="nome-proj" data-mask>{p.titulo}</h3>
            </div>
            <p class="categoria">{p.categoria}</p>
          </header>

          <div class="mt-8 grid items-center gap-12 lg:mt-12 lg:grid-cols-12 lg:gap-14">
            <div class="reveal lg:col-span-5" style="--d:60ms">
              <ul class="feitos text-[1.05rem] leading-relaxed" data-stagger>
                {p.bullets.map((b) => <li>{b}</li>)}
              </ul>
              <ul class="mt-7 flex flex-wrap gap-2" aria-label="Tecnologias" data-stagger>
                {p.tags.map((t) => <li class="pill pill-dark">{t}</li>)}
              </ul>
              {p.link && (
                <a
                  href={p.link.href}
                  target="_blank"
                  rel="noopener"
                  class="group mt-7 inline-flex min-h-11 items-center gap-2 font-semibold text-white underline decoration-white/30 underline-offset-[6px] transition-colors duration-(--dur-ui) hover:decoration-lilac"
                >
                  {p.link.rotulo}
                  <ExternalLink class="size-4 transition-transform duration-(--dur-ui) ease-(--expo) group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
                  <span class="sr-only">(abre em nova aba)</span>
                </a>
              )}
            </div>

            <figure class="reveal lg:col-span-7" style="--d:120ms">
              <Mockup />
              <figcaption class="mt-3 text-right text-[0.82rem] text-on-dark-muted">{projetosIntro.legendaMockup}</figcaption>
            </figure>
          </div>
        </div>
      </article>
    );
  })}
</section>

<style>
  /* Card escuro que se expande até ocupar a largura toda conforme a rolagem.
     --p vai de 0 (seção entrando) a 1 (topo da seção perto do topo da tela). */
  .proj-shell {
    --p: 1;
    --gap: clamp(12px, 4vw, 56px);
    clip-path: inset(0 calc((1 - var(--p)) * var(--gap)) round calc((1 - var(--p)) * 40px) calc((1 - var(--p)) * 40px) 0 0);
    background:
      radial-gradient(60% 40% at 85% 0%, rgb(45 98 234 / 0.22), transparent 70%),
      var(--color-night-3);
  }

  .cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .caixa { container-type: inline-size; flex: 1 1 100%; min-width: 0; }
  @media (min-width: 1024px) { .caixa { flex-basis: 32rem; } }
  .nome-proj {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 900;
    font-stretch: 80%;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: -0.01em;
    font-size: min(5.6rem, 12cqi);
    color: #fff;
    text-wrap: balance;
  }
  .categoria { color: var(--color-lilac); font-size: 1.05rem; }
  /* Traço curto no lugar da bolinha */
  .feitos > li { position: relative; padding-left: 1.4rem; }
  .feitos > li + li { margin-top: 0.65rem; }
  .feitos > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.7rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-lilac);
  }

  /* A abertura do card segue a rolagem direto no CSS, sem JavaScript a cada evento.
     Navegadores sem suporte usam o cálculo em main.ts. */
  @property --p { syntax: '<number>'; inherits: true; initial-value: 1; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Duas animações: abre ao entrar (própria rolagem) e afunda quando Trajetória sobe por cima (cascata) */
      .proj-shell {
        animation-name: abre-card, afunda;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view(), --c5;
        animation-range: entry 0% entry 90%, entry 0% entry 100%;
      }
    }
  }
  @keyframes abre-card { from { --p: 0; } to { --p: 1; } }

</style>
