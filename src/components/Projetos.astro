---
import { ExternalLink } from '@lucide/astro';
import { projetos, projetosIntro } from '../data/projetos';
import UniFlow from './mockups/UniFlow.astro';
import Jukebox from './mockups/Jukebox.astro';
import Glpi from './mockups/Glpi.astro';

const mockups = { uniflow: UniFlow, jukebox: Jukebox, glpi: Glpi };
const letras = [...projetosIntro.titulo];
---
<section id="projetos" class="proj-shell on-dark text-on-dark" aria-labelledby="projetos-titulo" data-expand>
  <!-- Palavra gigante cortada pela borda, como uma cena emoldurada -->
  <div class="reveal proj-intro container-x pt-14 sm:pt-20 lg:pt-24">
    <h2 id="projetos-titulo" class="proj-word font-display font-extrabold text-white">
      <span class="sr-only">{projetosIntro.titulo}</span>
      <span class="proj-line" aria-hidden="true">
        {letras.map((ch, i) => <span class="proj-ch" style={`--i:${i}`}>{ch}</span>)}
      </span>
    </h2>
  </div>

  {projetos.map((p, i) => {
    const Mockup = mockups[p.mockup];
    return (
      <article
        id={`projeto-${p.id}`}
        class={`relative overflow-hidden py-20 sm:py-28 lg:py-32 border-t border-white/[0.06]`}
        aria-labelledby={`projeto-${p.id}-titulo`}
      >
        <span class="big-num pointer-events-none absolute -right-2 top-6 select-none text-[9rem] text-white/[0.04] sm:text-[13rem] lg:top-10 lg:text-[18rem]" data-num={p.numero} aria-hidden="true"></span>

        <div class="container-x relative grid items-center gap-12 lg:grid-cols-12 lg:gap-14">
          <div class="reveal lg:col-span-5">
            <p class="eyebrow">Projeto {p.numero} · {p.categoria}</p>
            <h3 id={`projeto-${p.id}-titulo`} class="mt-4 text-[2.4rem] font-bold leading-[1.05] text-white sm:text-5xl">{p.titulo}</h3>
            <ul class="mt-6 space-y-2.5 text-[1.05rem] leading-relaxed">
              {p.bullets.map((b) => (
                <li class="flex gap-3">
                  <span class="mt-[0.7em] size-1.5 shrink-0 rounded-full bg-lilac" aria-hidden="true"></span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            <ul class="mt-7 flex flex-wrap gap-2" aria-label="Tecnologias">
              {p.tags.map((t) => <li class="pill pill-dark">{t}</li>)}
            </ul>
            {p.link && (
              <a
                href={p.link.href}
                target="_blank"
                rel="noopener"
                class="mt-7 inline-flex min-h-11 items-center gap-2 font-semibold text-white underline decoration-white/30 underline-offset-[6px] transition-colors hover:decoration-lilac"
              >
                {p.link.rotulo}
                <ExternalLink class="size-4" aria-hidden="true" />
                <span class="sr-only">(abre em nova aba)</span>
              </a>
            )}
          </div>

          <figure class="reveal lg:col-span-7" style="transition-delay:120ms">
            <Mockup />
            <figcaption class="mt-3 text-right text-[0.82rem] text-on-dark-muted">{projetosIntro.legendaMockup}</figcaption>
          </figure>
        </div>
      </article>
    );
  })}
</section>

<style>
  /* Card escuro que se expande até ocupar a largura toda conforme a rolagem.
     --p vai de 0 (seção entrando) a 1 (topo da seção perto do topo da tela). */
  .proj-shell {
    --p: 1;
    --gap: clamp(12px, 4vw, 56px);
    clip-path: inset(0 calc((1 - var(--p)) * var(--gap)) round calc((1 - var(--p)) * 40px) calc((1 - var(--p)) * 40px) 0 0);
    background:
      radial-gradient(60% 40% at 85% 0%, rgb(45 98 234 / 0.22), transparent 70%),
      var(--color-night-3);
  }
  .proj-word {
    font-stretch: 80%;
    font-size: clamp(3.6rem, 17.5vw, 14.5rem);
    line-height: 1;
    white-space: nowrap;
    letter-spacing: -0.055em;
  }
  /* corta a base das letras na linha da borda, como a palavra presa na moldura */
  .proj-line { display: block; overflow: hidden; height: 0.8em; padding-top: 0.04em; box-sizing: content-box; margin-bottom: -1px; }
  .proj-ch { display: inline-block; }
  .proj-intro { border-bottom: 1px solid rgb(255 255 255 / 0.08); }

  @media (prefers-reduced-motion: no-preference) {
    .proj-ch { transform: translateY(100%); transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 45ms); }
    :global(.is-in) .proj-ch, :global(.no-js) .proj-ch { transform: none; }
    /* a palavra também "afunda" um pouco enquanto o card abre */
    .proj-line { transform: translateY(calc((1 - var(--p)) * 12%)); }
  }
</style>
