---
import { Copy, Check, FileDown, ArrowUpRight, ArrowUp } from '@lucide/astro';
import { contato, site } from '../data/site';

const canais = [
  { nome: 'WhatsApp', ...contato.whatsapp },
  { nome: 'LinkedIn', ...contato.linkedin },
  { nome: 'GitHub', ...contato.github },
];
---
<section id="contato" class="contato-bg relative overflow-hidden text-on-dark" aria-labelledby="contato-titulo">
  <div class="container-x relative pt-20 pb-16 sm:pt-28 lg:pt-36 lg:pb-24">
    <div class="reveal caixa">
      <h2 id="contato-titulo" class="titulo">{contato.titulo}</h2>
    </div>

    <!-- E-mail é a ação principal: grande, clicável e com cópia ao lado -->
    <div class="reveal mt-10 lg:mt-14" style="--d:100ms">
      <p class="text-[1.05rem] text-on-dark-muted">O jeito mais rápido de falar comigo é por e-mail.</p>
      <div class="caixa mt-3">
        <div class="email-linha">
          <a href={`mailto:${contato.email}`} class="email">{contato.email}</a>
          <button type="button" class="copy-btn" data-copy={contato.email}>
            <Copy class="i-copy size-4" aria-hidden="true" />
            <Check class="i-check hidden size-4" aria-hidden="true" />
            <span data-copy-label>Copiar e-mail</span>
          </button>
          <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
        </div>
      </div>
    </div>

    <!-- Outros canais: mesmas linhas finas do índice de Serviços -->
    <ul class="canais reveal mt-12 lg:mt-16" style="--d:160ms" aria-label="Outros canais">
      {canais.map((c) => (
        <li>
          <a href={c.href} target="_blank" rel="noopener" class="canal group">
            <span class="canal-nome">{c.nome}</span>
            <span class="canal-valor">{c.rotulo}</span>
            <ArrowUpRight class="seta size-5 shrink-0" aria-hidden="true" />
            <span class="sr-only">(abre em nova aba)</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="reveal mt-10" style="--d:200ms">
      <a href={contato.pdf.href} download class="btn btn-sec">
        <FileDown class="size-5" aria-hidden="true" />
        {contato.pdf.rotulo}
      </a>
    </div>
  </div>

  <footer class="relative border-t border-line">
    <div class="container-x flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-[0.9rem] text-on-dark-muted">
      <p>© {new Date().getFullYear()} {site.nome}, {site.local}</p>
      <a href="#conteudo" class="topo inline-flex min-h-11 items-center gap-2 text-accent">
        Voltar ao topo
        <ArrowUp class="size-4" aria-hidden="true" />
      </a>
    </div>
  </footer>
</section>

<style>
  .contato-bg {
    background: var(--color-night-2);
    border-top: 1px solid var(--color-line);
  }
  .caixa { container-type: inline-size; }

  /* Mesmo corte do nome no hero, ocupando a largura */
  .titulo {
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-size: min(9rem, 18cqi); /* "Conversar?" cabe numa linha */
    color: var(--color-on-dark);
    text-wrap: balance;
  }

  .email-linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .email {
    font-weight: 500;
    font-size: min(3.4rem, 9cqi);
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--color-on-dark);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--color-line-strong);
    transition: text-decoration-color var(--dur-ui) var(--expo), color var(--dur-ui) var(--expo);
  }
  .email:hover { color: var(--color-lilac); text-decoration-color: currentColor; }

  .canais { border-bottom: 1px solid var(--color-line); }
  .canal {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.15rem 1rem;
    min-height: 64px;
    padding: 0.9rem 0;
    border-top: 1px solid var(--color-line);
  }
  .canal-nome { font-weight: 500; font-size: 1.05rem; letter-spacing: -0.015em; }
  .canal-valor {
    grid-column: 1;
    color: var(--color-on-dark-muted);
    overflow-wrap: anywhere;
    transition: color var(--dur-ui) var(--expo);
  }
  .seta {
    grid-column: 2;
    grid-row: 1 / span 2;
    transition: translate var(--dur-ui) var(--expo);
  }
  .canal:hover .canal-valor { color: var(--color-on-dark); }
  .canal:hover .seta { translate: 3px -3px; }
  @media (min-width: 768px) {
    .canal { grid-template-columns: 12rem minmax(0, 1fr) auto; padding: 1.1rem 0; }
    .canal-valor { grid-column: 2; }
    .seta { grid-column: 3; grid-row: 1; }
  }

  .topo:hover { text-decoration: underline; text-underline-offset: 4px; }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Largura do rótulo mais longo ("E-mail copiado"): o botão não cresce ao confirmar */
    min-width: 10.5rem;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: 9999px;
    border: 1px solid var(--color-accent);
    background: transparent;
    color: var(--color-accent);
    transition: background-color var(--dur-ui) var(--expo), border-color var(--dur-ui) var(--expo), transform var(--dur-fast) var(--expo);
    font-size: 0.95rem;
    font-weight: 400;
    flex-shrink: 0;
  }
  .copy-btn:hover { background: var(--color-accent); color: #fff; }
  .copy-btn:active { transform: scale(0.95); }
  .copy-btn.is-copied { background: var(--color-green); border-color: var(--color-green); color: #fff; }
  .copy-btn.is-copied .i-copy { display: none; }
  .copy-btn.is-copied .i-check { display: block; }
  /* Confirma a cópia com um pulo rápido do ✓ (resposta ao clique) */
  @media (prefers-reduced-motion: no-preference) {
    .copy-btn.is-copied { animation: copiado var(--dur-ui) var(--spring); }
    .copy-btn.is-copied .i-check { animation: check var(--dur-ui) var(--spring); }
  }
  @keyframes copiado { 40% { scale: 1.06; } }
  @keyframes check { from { scale: 0.4; rotate: -20deg; opacity: 0; } }
</style>
