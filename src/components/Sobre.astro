---
import { Cpu, CodeXml, ArrowRight } from '@lucide/astro';
import { sobre } from '../data/site';

const rich = (t: string) => t.replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-on-dark">$1</strong>');
const [abertura, formacao, jeito] = sobre.paragrafos;
---
<section id="sobre" class="py-20 sm:py-28 lg:py-32" aria-labelledby="sobre-titulo">
  <!-- Grade de blocos: quem eu sou, o que faço hoje, de onde venho e como trabalho -->
  <div class="container-x bento">
    <div class="bloco bloco-eu reveal">
      <!-- Pouso do avatar que vem voando do hero (sem JS ou com movimento reduzido, ele já está aqui) -->
      <span class="pouso" data-pouso aria-hidden="true">
        <img src="/avatar/luiz-440.webp" width="440" height="544" alt="" loading="lazy" decoding="async" />
      </span>
      <h2 id="sobre-titulo" class="titulo">{sobre.titulo}</h2>
    </div>

    <div class="bloco bloco-hoje reveal" style="--d:80ms">
      <p class="abertura" set:html={rich(abertura)} />
    </div>

    <!-- Do hardware ao código: a formação desenhada como um caminho -->
    <div class="bloco bloco-caminho reveal" style="--d:140ms">
      <div class="caminho" aria-hidden="true">
        <span class="chip chip-hw"><Cpu class="size-6" /></span>
        <ArrowRight class="seta size-5" />
        <span class="chip chip-code"><CodeXml class="size-6" /></span>
      </div>
      <p class="texto" set:html={rich(formacao)} />
    </div>

    <!-- Como trabalho, no formato de um chamado do GLPI -->
    <div class="bloco bloco-chamado reveal" style="--d:200ms">
      <div class="chamado-topo">
        <span class="chamado-id">Meu jeito de trabalhar</span>
        <span class="status">Resolvido</span>
      </div>
      <p class="chamado-texto" set:html={rich(jeito)} />
    </div>
  </div>
</section>

<style>
  .bento { display: grid; gap: 12px; }
  @media (min-width: 768px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bloco-eu, .bloco-hoje { grid-column: span 2; }
  }
  @media (min-width: 1024px) {
    .bento { grid-template-columns: 5fr 3.5fr 3.5fr; }
    .bloco-eu { grid-column: 1; grid-row: 1 / span 2; }
    .bloco-hoje { grid-column: 2 / span 2; }
  }

  .bloco {
    border-radius: 28px;
    padding: 28px;
    background: #fff;
  }
  @media (min-width: 1024px) { .bloco { padding: 36px; } }

  /* Bloco principal no degradê do Contato: a página começa e termina na mesma cor */
  .bloco-eu {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: 18rem;
    color: #fff;
    background:
      radial-gradient(70% 60% at 85% 10%, rgb(255 255 255 / 0.18), transparent 70%),
      linear-gradient(140deg, #0050b3 0%, #3a3ad6 60%, #6b3fd4 100%);
  }
  .titulo {
    font-size: clamp(2.4rem, 1.6rem + 2.6vw, 3.6rem);
    line-height: 1.02;
    color: #fff;
  }

  .abertura {
    font-size: clamp(1.3rem, 1.05rem + 0.9vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--color-on-dark);
    text-wrap: pretty;
  }

  .caminho { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .chip {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    color: #fff;
  }
  .chip-hw { background: linear-gradient(135deg, #b35f00, #f08a24); }
  .chip-code { background: linear-gradient(135deg, #0050b3, #3a8dff); }
  .seta { color: var(--color-muted); }
  .texto { color: var(--color-ink-muted); line-height: 1.55; }

  /* Chamado: a mesma janela escura dos mockups de projeto */
  .bloco-chamado { background: #1d1d1f; color: #f5f5f7; }
  .chamado-topo { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .chamado-id { font-size: 0.9rem; color: #a1a1a6; }
  .status {
    padding: 0.2rem 0.7rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #0b2e14;
    background: #30d158;
  }
  .chamado-texto { font-size: 1.35rem; line-height: 1.3; letter-spacing: -0.02em; color: #f5f5f7; }
  .chamado-texto :global(strong) { color: #30d158; font-weight: 600; }

  .pouso {
    position: relative;
    display: block;
    width: 5.5rem;
    aspect-ratio: 1;
    border-radius: 9999px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.18);
  }
  .pouso::after { content: ''; position: absolute; inset: 0; border-radius: inherit; border: 2px solid #fff; }
  @media (min-width: 1024px) { .pouso { width: 8.5rem; } }
  /* Mesmo enquadramento do rosto usado pelo avatar em voo (main.ts) */
  .pouso img { position: absolute; left: -18.15%; top: -7.35%; width: 145%; max-width: none; height: auto; }
  /* Com o avatar em voo, o pouso é só o lugar: o círculo, o anel e a foto vêm do viajante */
  :global(.viaja) .pouso { background: none; }
  :global(.viaja) .pouso::after, :global(.viaja) .pouso img { visibility: hidden; }
</style>
