---
import { sobre } from '../data/site';

const rich = (t: string) => t.replace(/\*\*(.+?)\*\*/g, '<strong class="font-medium text-white">$1</strong>');
const [abertura, ...resto] = sobre.paragrafos;
---
<section id="sobre" class="py-20 sm:py-28 lg:py-32" aria-labelledby="sobre-titulo">
  <div class="container-x grid gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="reveal lg:col-span-5">
      <!-- Pouso do avatar que vem voando do hero (sem JS ou com movimento reduzido, ele já está aqui) -->
      <span class="pouso" data-pouso aria-hidden="true">
        <img src="/avatar/luiz-440.webp" width="440" height="544" alt="" loading="lazy" decoding="async" />
      </span>
      <h2 id="sobre-titulo" class="text-[2.4rem] leading-[1.05] sm:text-[3rem] lg:text-[3.5rem]">{sobre.titulo}</h2>
    </div>

    <div class="reveal lg:col-span-7 lg:max-w-[60ch] lg:pt-3" style="--d:100ms">
      <!-- Abertura maior em branco; o resto em tom de apoio -->
      <p class="abertura" set:html={rich(abertura)} />
      <div class="mt-6 space-y-5 text-[1.05rem] leading-[1.75] text-muted sm:text-[1.1rem]">
        {resto.map((p) => <p set:html={rich(p)} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .pouso {
    position: relative;
    display: block;
    width: 5.5rem;
    aspect-ratio: 1;
    margin-bottom: 1.5rem;
    border-radius: 9999px;
    overflow: hidden;
    background: var(--color-night-4);
  }
  .pouso::after { content: ''; position: absolute; inset: 0; border-radius: inherit; border: 2px solid var(--color-accent); }
  @media (min-width: 1024px) { .pouso { width: 8.5rem; margin-bottom: 2rem; } }
  /* Mesmo enquadramento do rosto usado pelo avatar em voo (main.ts) */
  .pouso img { position: absolute; left: -18.15%; top: -7.35%; width: 145%; max-width: none; height: auto; }
  /* Com o avatar em voo, o pouso é só o lugar: o círculo, o anel e a foto vêm do viajante */
  :global(.viaja) .pouso { background: none; }
  :global(.viaja) .pouso::after, :global(.viaja) .pouso img { visibility: hidden; }
  .abertura {
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.5rem);
    line-height: 1.45;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--color-on-dark);
    text-wrap: pretty;
    max-width: 34ch;
  }
</style>
