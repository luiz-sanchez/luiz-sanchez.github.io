---
import { Menu, X } from '@lucide/astro';
import { site } from '../data/site';
---
<header id="topo" class="fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow,backdrop-filter] duration-300" data-header>
  <div class="container-x flex h-16 items-center justify-between">
    <a href="#inicio" class="flex items-center gap-2.5 rounded-lg" aria-label="Luiz Sanchez, voltar ao início">
      <span class="bg-blue-grad grid size-10 place-items-center rounded-[10px] font-display text-[0.95rem] font-extrabold tracking-tight text-white" aria-hidden="true">LS</span>
      <span class="hidden font-display text-[0.95rem] font-bold tracking-tight sm:inline">Luiz Sanchez</span>
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-1 rounded-full border border-ink/10 bg-paper p-1 shadow-[0_8px_24px_-16px_rgb(20_22_27/0.4)]">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} data-nav-link class="nav-link block rounded-full px-4 py-2.5 text-[0.85rem] font-medium text-muted transition-colors hover:text-ink">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="grid size-11 place-items-center rounded-full border border-ink/10 bg-paper/90 md:hidden"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Abrir menu"
      data-menu-toggle
    >
      <Menu class="icon-open size-5" aria-hidden="true" />
      <X class="icon-close hidden size-5" aria-hidden="true" />
    </button>
  </div>

  <nav id="menu-mobile" aria-label="Principal (celular)" class="hidden border-t border-ink/10 bg-paper md:hidden" data-menu>
    <ul class="container-x flex flex-col py-3">
      {site.nav.map((item) => (
        <li>
          <a href={item.href} data-nav-link class="nav-link flex min-h-12 items-center border-b border-ink/5 font-display text-xl font-bold last:border-0">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  [data-header].is-scrolled {
    background: rgb(245 244 240 / 0.86);
    backdrop-filter: saturate(1.4) blur(12px);
    box-shadow: 0 1px 0 rgb(20 22 27 / 0.08);
  }
  .nav-link[aria-current='true'] {
    color: #fff;
    background: var(--color-blue);
  }
  #menu-mobile .nav-link[aria-current='true'] {
    background: none;
    color: var(--color-blue);
  }
  [data-menu-toggle][aria-expanded='true'] .icon-open { display: none; }
  [data-menu-toggle][aria-expanded='true'] .icon-close { display: block; }
</style>
