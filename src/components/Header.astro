---
import { Menu, X, Mail } from '@lucide/astro';
import { site } from '../data/site';
---
<header id="topo" class="fixed inset-x-0 top-0 z-50" data-header>
  <div class="bar relative"><div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-4 px-5 sm:px-8 lg:px-10">
    <span class="progresso" aria-hidden="true"></span>
    <a href="#inicio" class="logo flex min-h-11 items-center gap-2.5 rounded-lg" aria-label="Luiz Sanchez, voltar ao início">
      <img class="logo-foto" src="/avatar/luiz-logo.webp" width="40" height="40" alt="" />
      <span class="text-[0.98rem] font-semibold tracking-[-0.02em] text-white" aria-hidden="true">{site.nome}</span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} data-nav-link class="nav-link nav-desk block px-3 py-3 text-[0.9rem]">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="#contato" class="cta hidden min-h-11 items-center gap-2 rounded-lg px-4 text-[0.9rem] font-medium text-white sm:inline-flex">
        <Mail class="size-4" aria-hidden="true" />
        {site.ctas.contato}
      </a>
      <button
        type="button"
        class="toggle grid size-11 place-items-center rounded-lg border border-line-strong bg-night-2 text-white lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu"
        data-menu-toggle
      >
        <Menu class="icon-open size-5" aria-hidden="true" />
        <X class="icon-close size-5" aria-hidden="true" />
      </button>
    </div>
  </div></div>

  <nav id="menu-mobile" aria-label="Principal (celular)" class="menu absolute inset-x-3 top-full mx-auto mt-2 max-w-[1200px] rounded-xl sm:inset-x-5 lg:hidden" data-menu>
    <ul class="flex flex-col px-6 py-3">
      {site.nav.map((item) => (
        <li>
          <a href={item.href} data-nav-link class="nav-link nav-cel flex min-h-14 items-center border-b border-line text-white">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* Barra reta de ponta a ponta; o fio de baixo só aparece depois de rolar */
  .bar {
    background: rgb(8 9 10 / 0.6);
    border-bottom: 1px solid transparent;
    backdrop-filter: saturate(1.2) blur(16px);
    transition: background-color var(--dur-ui) var(--expo), border-color var(--dur-ui) var(--expo);
  }
  [data-header].is-scrolled .bar { background: rgb(8 9 10 / 0.86); border-bottom-color: var(--color-line); }
  .menu {
    background: rgb(15 16 17 / 0.96);
    border: 1px solid var(--color-line);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05);
    backdrop-filter: blur(16px);
  }
  /* Linha de progresso da leitura, ligada à rolagem (só onde o navegador suporta) */
  .progresso {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(0);
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    .progresso { animation-name: progresso; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root); }
  }
  @keyframes progresso { to { transform: scaleX(1); } }
  .logo-foto {
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--color-accent);
    transition: box-shadow var(--dur-ui) var(--expo);
  }
  .logo:hover .logo-foto { box-shadow: 0 0 0 2px var(--color-lilac); }
  .cta { background: var(--color-accent); transition: background-color var(--dur-ui) var(--expo), transform var(--dur-ui) var(--expo); }
  .cta:active { transform: scale(0.97); transition-duration: var(--dur-fast); }
  .cta:hover { background: #6b77e0; }
  /* Links do computador: cinza claro, a seção atual em branco com um traço azul-claro */
  .nav-desk {
    position: relative;
    color: var(--color-on-dark-muted);
    transition: color var(--dur-ui) var(--expo);
  }
  .nav-desk:hover { color: #fff; }
  .nav-desk::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 9999px;
    background: var(--color-lilac);
    scale: 0 1;
    transition: scale var(--dur-ui) var(--expo);
  }
  .nav-desk[aria-current='true'] { color: #fff; }
  .nav-desk[aria-current='true']::after { scale: 1 1; }

  /* Menu do celular: links no corte do nome no hero */
  .nav-cel {
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  li:last-child > .nav-cel { border-bottom: 0; }
  .nav-cel[aria-current='true'] { color: var(--color-lilac); }
  /* Ícone ☰ ↔ ✕: os dois no mesmo lugar, trocam girando */
  .toggle > :global(svg) { grid-area: 1 / 1; transition: opacity var(--dur-ui) var(--expo), rotate var(--dur-ui) var(--expo); }
  .toggle .icon-close { opacity: 0; rotate: -90deg; }
  [data-menu-toggle][aria-expanded='true'] .icon-open { opacity: 0; rotate: 90deg; }
  [data-menu-toggle][aria-expanded='true'] .icon-close { opacity: 1; rotate: 0deg; }
  .toggle:active { scale: 0.94; }

  /* Menu do celular sai do botão (canto superior direito): abre em 260ms, fecha em 160ms */
  .menu {
    visibility: hidden;
    opacity: 0;
    translate: 0 -10px;
    scale: 0.97;
    transform-origin: top right;
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease-in),
      translate var(--dur-fast) var(--ease-in),
      scale var(--dur-fast) var(--ease-in),
      visibility 0s linear var(--dur-fast);
  }
  .menu.is-open {
    visibility: visible;
    opacity: 1;
    translate: none;
    scale: 1;
    pointer-events: auto;
    transition:
      opacity var(--dur-ui) var(--expo),
      translate var(--dur-ui) var(--expo),
      scale var(--dur-ui) var(--expo),
      visibility 0s;
  }
  /* Links entram em sequência ao abrir */
  .menu li { opacity: 0; translate: 0 6px; transition: opacity var(--dur-fast) var(--ease-in), translate var(--dur-fast) var(--ease-in); }
  .menu.is-open li { opacity: 1; translate: none; transition: opacity var(--dur-ui) var(--expo), translate var(--dur-ui) var(--expo); }
  .menu.is-open li:nth-child(2) { transition-delay: calc(var(--stagger) * 1); }
  .menu.is-open li:nth-child(3) { transition-delay: calc(var(--stagger) * 2); }
  .menu.is-open li:nth-child(4) { transition-delay: calc(var(--stagger) * 3); }
  .menu.is-open li:nth-child(5) { transition-delay: calc(var(--stagger) * 4); }
</style>
