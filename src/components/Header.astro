---
import { Menu, X, Mail } from '@lucide/astro';
import { site } from '../data/site';
---
<header id="topo" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-5 sm:pt-4" data-header>
  <div class="bar mx-auto flex h-16 max-w-[1320px] items-center justify-between gap-4 rounded-full pl-5 pr-2 sm:pl-7">
    <a href="#inicio" class="logo rounded-lg font-display text-[1.7rem] leading-none" aria-label="Luiz Sanchez, voltar ao início">
      <span aria-hidden="true">L<span class="logo-s">S</span></span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} data-nav-link class="nav-link block rounded-full px-4 py-3 text-[0.8rem] font-medium uppercase tracking-[0.08em] text-on-dark transition-colors hover:text-white">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="#contato" class="cta border-grad hidden min-h-12 items-center gap-2.5 rounded-full px-5 text-[0.8rem] font-semibold uppercase tracking-[0.06em] text-white sm:inline-flex">
        <Mail class="size-4" aria-hidden="true" />
        {site.ctas.contato}
      </a>
      <button
        type="button"
        class="grid size-12 place-items-center rounded-full border border-white/10 text-white lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu"
        data-menu-toggle
      >
        <Menu class="icon-open size-5" aria-hidden="true" />
        <X class="icon-close hidden size-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav id="menu-mobile" aria-label="Principal (celular)" class="menu mx-auto mt-2 hidden max-w-[1320px] rounded-[24px] lg:hidden" data-menu>
    <ul class="flex flex-col px-6 py-3">
      {site.nav.map((item) => (
        <li>
          <a href={item.href} data-nav-link class="nav-link flex min-h-14 items-center border-b border-white/[0.06] font-display text-2xl text-white last:border-0">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .bar, .menu {
    background: rgb(8 11 18 / 0.72);
    border: 1px solid rgb(255 255 255 / 0.07);
    backdrop-filter: saturate(1.4) blur(14px);
  }
  [data-header].is-scrolled .bar { background: rgb(8 11 18 / 0.9); }
  .logo { font-style: italic; font-weight: 900; font-stretch: 118%; color: #fff; letter-spacing: -0.04em; }
  .logo-s {
    background: linear-gradient(135deg, #3b82f6, #38bdf8);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cta { --grad-fill: #0a0d14; transition: box-shadow 0.25s; }
  .cta:hover { box-shadow: 0 0 24px -6px rgb(56 189 248 / 0.6); }
  .nav-link[aria-current='true'] { color: #fff; background: rgb(45 98 234 / 0.28); }
  #menu-mobile .nav-link[aria-current='true'] { background: none; color: var(--color-lilac); }
  [data-menu-toggle][aria-expanded='true'] .icon-open { display: none; }
  [data-menu-toggle][aria-expanded='true'] .icon-close { display: block; }
</style>
