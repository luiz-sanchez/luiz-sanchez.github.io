---
import { trajetoriaIntro, formacao, experiencias, ferramentas, colunas } from '../data/trajetoria';

const atual = (periodo: string) => /atual/i.test(periodo);
---
<section id="trajetoria" class="py-20 sm:py-28 lg:py-36" aria-labelledby="trajetoria-titulo">
  <div class="container-x">
    <div class="reveal">
      <h2 id="trajetoria-titulo" class="text-[2.2rem] leading-[1.05] sm:text-[2.8rem] lg:text-[3.1rem]">{trajetoriaIntro.titulo}</h2>
    </div>

    <div class="mt-10 grid gap-14 lg:mt-14 lg:grid-cols-12 lg:gap-16">
      <!-- Experiências em destaque: é o que quem contrata procura antes -->
      <div class="reveal lg:col-span-7">
        <h3 class="sub">{colunas.experiencias}</h3>
        <ol class="linha mt-7" data-stagger>
          {experiencias.map((it) => (
            <li class:list={['item', { 'is-atual': atual(it.periodo) }]}>
              <p class="periodo">{it.periodo}</p>
              <p class="mt-1.5 text-[1.05rem] font-semibold leading-snug text-ink-muted">{it.titulo}</p>
              <p class="mt-1 text-muted">{it.local}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="space-y-14 lg:col-span-5">
        <div class="reveal" style="--d:80ms">
          <h3 class="sub">{colunas.formacao}</h3>
          <ol class="linha linha-leve mt-7" data-stagger>
            {formacao.map((it) => (
              <li class="item">
                <p class="periodo periodo-leve">{it.periodo}</p>
                <p class="mt-1 font-semibold leading-snug text-on-dark">{it.titulo}</p>
                <p class="mt-1 text-[0.95rem] text-muted">{it.local}</p>
              </li>
            ))}
          </ol>
        </div>

        <div class="reveal" style="--d:160ms">
          <h3 class="sub">{colunas.ferramentas}</h3>
          <ul class="mt-6 flex flex-wrap gap-2" data-stagger>
            {ferramentas.map((f) => <li class="pill pill-soft">{f}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sub { font-size: 0.9rem; font-weight: 600; letter-spacing: 0; color: var(--color-muted); }

  .linha { position: relative; }
  /* Fio vertical da linha do tempo */
  .linha::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
    background: var(--color-line);
  }
  .item {
    position: relative;
    padding: 0 0 2.2rem 2rem;
  }
  .item:last-child { padding-bottom: 0; }
  .linha-leve .item { padding-bottom: 1.6rem; }
  .linha-leve .item:last-child { padding-bottom: 0; }
  .item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62rem;
    width: 11px;
    height: 11px;
    border-radius: 9999px;
    background: var(--color-night);
    border: 2px solid var(--color-line-strong);
  }
  /* Emprego atual: ponto cheio com anel */
  .is-atual::before {
    background: var(--color-green);
    border-color: var(--color-green);
    box-shadow: 0 0 0 4px rgb(39 166 68 / 0.18);
  }
  /* Emprego atual: um anel que se expande devagar, como sinal de "ao vivo" */
  @media (prefers-reduced-motion: no-preference) {
    .is-atual::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0.62rem;
      width: 11px;
      height: 11px;
      border-radius: 9999px;
      border: 2px solid var(--color-green);
      animation: ao-vivo 2.4s var(--expo) infinite;
      pointer-events: none;
    }
  }
  @keyframes ao-vivo {
    from { scale: 1; opacity: 0.7; }
    70%, to { scale: 2.6; opacity: 0; }
  }

  /* Período no corte de display: a sequência é a informação aqui */
  .periodo {
    font-weight: 600;
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--color-on-dark);
    font-variant-numeric: tabular-nums;
  }
  .periodo-leve { font-size: 1.1rem; top: 0; color: var(--color-ink-muted); }
  .linha-leve .item::before { top: 0.42rem; }
</style>
