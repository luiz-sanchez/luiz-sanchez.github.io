---
import { trajetoriaIntro, formacao, experiencias, ferramentas, colunas } from '../data/trajetoria';

// Experiências primeiro: é o que quem contrata procura antes.
const listas = [
  { titulo: colunas.experiencias, itens: experiencias },
  { titulo: colunas.formacao, itens: formacao },
];
---
<section id="trajetoria" class="py-20 sm:py-28 lg:py-36" aria-labelledby="trajetoria-titulo">
  <div class="container-x">
    <div class="reveal">
      <h2 id="trajetoria-titulo" class="text-[2.2rem] leading-[1.05] sm:text-[2.8rem] lg:text-[3.1rem]">{trajetoriaIntro.titulo}</h2>
    </div>

    <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-14">
      {listas.map((col, ci) => (
        <div class="reveal lg:col-span-4" style={`--d:${ci * 80}ms`}>
          <h3 class="text-[1.3rem] font-bold text-white">{col.titulo}</h3>
          <!-- Linha do tempo: período numa coluna, cargo e lugar na outra -->
          <ol class="linha mt-6" data-stagger>
            {col.itens.map((it) => (
              <li class="item">
                <p class="periodo tabular-nums">{it.periodo}</p>
                <div>
                  <p class="font-semibold leading-snug text-white">{it.titulo}</p>
                  <p class="mt-1 text-[0.95rem] text-muted">{it.local}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}

      <div class="reveal lg:col-span-4" style="--d:160ms">
        <h3 class="text-[1.3rem] font-bold text-white">{colunas.ferramentas}</h3>
        <ul class="mt-6 flex flex-wrap gap-2" data-stagger>
          {ferramentas.map((f) => <li class="pill pill-soft">{f}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .linha { position: relative; }
  /* Fio vertical da linha do tempo */
  .linha::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--color-line);
  }
  .item {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: 0 0 1.6rem 1.75rem;
  }
  .item:last-child { padding-bottom: 0; }
  .item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42rem;
    width: 11px;
    height: 11px;
    border-radius: 9999px;
    background: var(--color-night);
    border: 2px solid var(--color-accent);
  }
  .item:first-child::before { background: var(--color-accent); }
  .periodo { font-size: 0.85rem; font-weight: 600; color: var(--color-lilac); }
</style>
