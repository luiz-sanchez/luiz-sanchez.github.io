---
import { trajetoriaIntro, formacao, experiencias, ferramentas, colunas } from '../data/trajetoria';

const listas = [
  { titulo: colunas.formacao, itens: formacao },
  { titulo: colunas.experiencias, itens: experiencias },
];
---
<section id="trajetoria" class="py-20 sm:py-28 lg:py-36" aria-labelledby="trajetoria-titulo">
  <div class="container-x">
    <div class="reveal">
      <p class="eyebrow">{trajetoriaIntro.eyebrow}</p>
      <h2 id="trajetoria-titulo" class="mt-4 text-[2.3rem] font-bold leading-[1.05] sm:text-5xl lg:text-[3.6rem]">{trajetoriaIntro.titulo}</h2>
    </div>

    <div class="mt-10 grid gap-5 lg:mt-14 lg:grid-cols-3">
      {listas.map((col, ci) => (
        <div class="col reveal" style={`transition-delay:${ci * 80}ms`}>
          <h3 class="text-[1.4rem] font-bold">{col.titulo}</h3>
          <ol class="timeline mt-5 space-y-6">
            {col.itens.map((it) => (
              <li class="relative">
                <p class="font-semibold leading-snug">{it.titulo}</p>
                <p class="mt-1 text-[0.92rem] text-muted">{it.local} · {it.periodo}</p>
              </li>
            ))}
          </ol>
        </div>
      ))}

      <div class="col reveal" style="transition-delay:160ms">
        <h3 class="text-[1.4rem] font-bold">{colunas.ferramentas}</h3>
        <ul class="mt-5 flex flex-wrap gap-2">
          {ferramentas.map((f) => <li class="pill pill-soft">{f}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .col {
    border-radius: var(--radius-card);
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
    border-top: 4px solid var(--color-blue);
    padding: 1.75rem;
  }
  /* Linha do tempo vertical no mobile */
  .timeline { position: relative; padding-left: 1.5rem; }
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 2px;
    background: #d5dcf3;
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem + 1px);
    top: 0.4rem;
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: var(--color-paper-2);
    border: 2px solid var(--color-blue);
  }
  .timeline > li:first-child::before { background: var(--color-blue); }
  @media (min-width: 1024px) {
    .timeline { padding-left: 0; }
    .timeline::before, .timeline > li::before { display: none; }
  }
</style>
